{
  "name": "skyfork",
  "productName": "SkyFork",
  "version": "0.1.0",
  "description": "Cross-platform desktop Git client",
  "author": "Skycode",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "cross-env VITE_DEV_PORT=5188 concurrently --kill-others-on-fail \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "npm run dev --prefix src/renderer",
    "dev:main": "cross-env SKYFORK_VITE=1 npx tsc -p tsconfig.main.json && node scripts/wait-dev-server.mjs && cross-env SKYFORK_VITE=1 npx electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "npx tsc -p tsconfig.main.json",
    "build:renderer": "npm run build --prefix src/renderer",
    "start": "npx electron .",
    "clean": "rimraf dist",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && npm test && electron-builder",
    "dist:win": "npm run build && npm test && electron-builder --win",
    "dist:mac": "npm run build && npm test && electron-builder --mac",
    "dist:linux": "npm run build && npm test && electron-builder --linux",
    "analyze": "cross-env SKYFORK_ANALYZE=1 npm run build:renderer",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "build": {
    "appId": "com.skycode.skyfork",
    "productName": "SkyFork",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.19.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^40.9.3",
    "electron-builder": "^26.0.20",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3",
    "prettier": "^3.8.3",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.4"
  }
}
