{
  "name": "gitbor",
  "productName": "GitBor",
  "version": "0.1.17",
  "description": "Cross-platform desktop Git client",
  "author": "Ruslan Sinkevich <ruslan-sink@mail.ru>",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/write-build-flags.mjs && cross-env VITE_DEV_PORT=5188 concurrently --kill-others-on-fail \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "npm run dev --prefix src/renderer",
    "dev:main": "cross-env GITBOR_VITE=1 npx tsc -p tsconfig.main.json && node scripts/wait-dev-server.mjs && cross-env GITBOR_VITE=1 npx electron .",
    "build": "node scripts/write-build-flags.mjs && npm run build:renderer && npm run build:main",
    "build:main": "npx tsc -p tsconfig.main.json",
    "build:renderer": "npm run build --prefix src/renderer",
    "build:icons": "node scripts/build-icons.mjs",
    "start": "npx electron .",
    "clean": "rimraf dist",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && npm test && electron-builder",
    "dist:win": "npm run build && npm test && electron-builder --win",
    "dist:win:no-ai": "cross-env GITBOR_AI=0 npm run build && npm test && rimraf release/no_ai && electron-builder --win --config.directories.output=release/no_ai --config.productName=\"GitBor No AI\" --config.appId=ru.gitbor.app.noai --config.publish.url=https://storage.yandexcloud.net/gitbor/stable/win/no_ai/ --config.nsis.artifactName=\"GitBor-NoAI-Setup-${version}.${ext}\" --config.portable.artifactName=\"GitBor-NoAI-Portable-${version}.${ext}\"",
    "dist:win:all": "node scripts/dist-win-variants.mjs",
    "dist:mac": "npm run build && npm test && electron-builder --mac",
    "dist:linux": "npm run build && npm test && electron-builder --linux",
    "analyze": "cross-env GITBOR_ANALYZE=1 npm run build:renderer",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "build": {
    "appId": "ru.gitbor.app",
    "productName": "GitBor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "icon": "resources/icon.icns",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "resources/icons",
      "maintainer": "Ruslan Sinkevich <ruslan-sink@mail.ru>",
      "synopsis": "Cross-platform desktop Git client",
      "description": "GitBor is a cross-platform desktop Git client built on Electron, providing a fast and intuitive interface for Git repository management.",
      "desktop": {
        "entry": {
          "Name": "GitBor",
          "Categories": "Development;RevisionControl;",
          "StartupWMClass": "GitBor",
          "MimeType": "inode/directory;"
        }
      }
    },
    "deb": {
      "afterInstall": "build/linux-after-install.sh"
    },
    "rpm": {
      "afterInstall": "build/linux-after-install.sh"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://storage.yandexcloud.net/gitbor/stable/win/"
    }
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^40.9.3",
    "electron-builder": "^26.0.20",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3",
    "png2icons": "^2.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "rimraf": "^5.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.4"
  }
}
